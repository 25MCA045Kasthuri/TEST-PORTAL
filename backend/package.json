{
  "name": "swap2k26-backend",
  "version": "1.0.0",
  "description": "SWAP 2K26 Mobile Test Portal - backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "prestart": "tsx src/scripts/ensureAdmin.ts",
    "start": "node dist/server.js",
    "seed:admin": "tsx src/scripts/seed.ts",
    "seed": "SEED_CANDIDATES=1 tsx src/scripts/seed.ts",
    "migrate:candidate-passwords": "tsx src/scripts/migrateCandidatePasswords.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
