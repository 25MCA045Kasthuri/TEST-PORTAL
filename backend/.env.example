# ─────────────────────────────────────────────────────────
# SWAP 2K26 — Backend environment (TEMPLATE)
# Copy: cp .env.example .env  → then fill in real values.
# ─────────────────────────────────────────────────────────

# ── Server ──
PORT=5002
NODE_ENV=development

# ── Database ──
# Local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/swap2k26
# Example (Atlas): mongodb+srv://<user>:<password>@<cluster>/swap2k26?retryWrites=true

# ── Auth / JWT ──
# Generate with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string
COOKIE_NAME=swap2k26_token
TOKEN_TTL_HOURS=6

# ── CORS / Frontend ──
FRONTEND_URL=http://localhost:5174

# ── Bootstrap admin ──
ADMIN_EMAIL=admin@swap2k26.test
ADMIN_PASSWORD=change-this-password

# ── Seeding (optional) ──
# 1 = create sample candidates when running the seed script
SEED_CANDIDATES=0